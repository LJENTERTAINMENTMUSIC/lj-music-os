# ==============================================================================
# LJ MUSIC OS - ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3456
NODE_ENV=production

# 1. SUPABASE CREDENTIALS (Find in Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. VERCEL CONFIGURATION
VERCEL_ENV=production

# 3. GITHUB REPOSITORY
GITHUB_REPOSITORY=LJENTERTAINMENTMUSIC/lj-music-os
